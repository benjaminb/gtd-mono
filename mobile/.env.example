# API Configuration
# For physical devices, set this to your computer's IP address on the local network
# Find your IP:
#   macOS: ipconfig getifaddr en0
#   Linux: hostname -I | awk '{print $1}'
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Leave empty to use automatic detection (localhost for simulators/emulators)
# EXPO_PUBLIC_API_URL=
