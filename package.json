{
  "name": "gtd-mono",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "mobile",
    "backend/database"
  ],
  "scripts": {
    "dev:web": "cd frontend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
